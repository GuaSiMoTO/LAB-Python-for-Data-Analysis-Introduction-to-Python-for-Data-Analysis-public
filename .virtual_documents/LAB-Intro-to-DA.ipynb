








import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns





data = {'Product ID': [101, 102, 103, 104],
 'Product Name': ['Laptop', 'Printer', 'Tablet', 'Desk'],
 'Price': [1200, 150, 300, 450]}

df = pd.DataFrame(data)

df['Category']=['Electronic','Electronic','Electronic','Furniture']

df['Stock']=[20,30,15,5]





print(df[['Product Name','Price']])

print(df.loc[df['Product ID'] == 103])

print(df.iloc[:3,:])

print(df.loc[df.Category == 'Electronic'])

df.loc[df['Product ID'] == 102, 'Price'] = 160





df_csv = pd.read_csv('products.csv')
df_csv= df_csv.rename(columns={'Product ID':'ID','Product Name':'Name'})
print(df_csv.head())





print(df_csv.loc[df_csv['Price'] > 200])

print(df_csv.loc[(df_csv['Category'] == 'Electronics') & (df_csv['Stock'] < 25)])

print(df_csv.sort_values(by='Price', ascending = False))

print(df_csv.loc[(df_csv['Supplier'] == 'Supplier B') & (df_csv['Stock']>20)])
## tambien se puede usar ISIN()
print(df_csv.loc[(df_csv['Supplier'].isin(['Supplier B'])) & (df_csv['Stock']>20)])

print(df_csv.loc[df_csv['Name'].str.startswith('T')])






print(df_csv.groupby('Category')['Price'].mean())

print(df_csv.groupby('Category')['Stock'].sum())

print(df_csv.groupby('Category')['Price'].max())

print(df_csv.groupby('Supplier')['Stock'].sum())

print(df_csv.groupby(['Category','Supplier'])['Price'].mean())
# También podemos ponerle un nombre a esa columna mean(), este caso 'Avg_Price'
print(df_csv.groupby(['Category','Supplier'])['Price'].mean().reset_index(name="Avg_Price"))





df_csv['Discounted Price'] = df_csv['Price'].map(lambda x: round(x * 0.9, 0))

df_csv['Total Stock Value'] = df_csv.apply(lambda row: row['Price'] * row['Stock'], axis=1)

df_csv['Price Category'] = df_csv['Price'].apply(lambda x: 'Expensive' if x > 500 else 'Cheap')
print(df_csv.columns)
print(df_csv)





#print(df_csv.describe())
print(df_csv['Category'].value_counts())





df_csv.to_csv("DataFrame_clean.csv",index=False)



